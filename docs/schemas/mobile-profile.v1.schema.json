{
  "$id": "https://github.com/AlexanderVegazo26/nawi/blob/main/docs/schemas/mobile-profile.v1.schema.json",
  "title": "Nawi mobile profile (version 1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "app": {
      "type": "object",
      "properties": {
        "apk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "The .apk this profile installs."
        },
        "package": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "version_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "version_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Of the .apk when the profile was saved."
        }
      },
      "required": [
        "apk",
        "package",
        "version_code",
        "version_name",
        "sha256"
      ],
      "additionalProperties": false
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "device",
                "avd"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Where the app ran: a connected device (adb serial) or a virtual device (AVD) name. Null: the best one available."
    },
    "permissions": {
      "type": "object",
      "properties": {
        "grant": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)+$"
          },
          "description": "Runtime permissions granted before launch (`pm grant`), so no dialog blocks a run."
        }
      },
      "required": [
        "grant"
      ],
      "additionalProperties": false
    },
    "launch": {
      "type": "object",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[A-Za-z_][A-Za-z0-9_$]*(?:\\.[A-Za-z_][A-Za-z0-9_$]*)+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "activity"
      ],
      "additionalProperties": false
    },
    "screen": {
      "description": "The UI framework found in the .apk and how Nawi reads its screen (refreshed with the app facts).",
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "enum": [
            "native",
            "flutter",
            "react_native",
            "game_engine",
            "webview"
          ]
        },
        "read": {
          "type": "string",
          "enum": [
            "accessibility",
            "flutter_semantics",
            "webview_cdp",
            "screenshot"
          ]
        }
      },
      "required": [
        "framework",
        "read"
      ],
      "additionalProperties": false
    },
    "device": {
      "description": "Device settings applied before launch. Missing (profiles saved before these settings existed): the device is left as it is.",
      "type": "object",
      "properties": {
        "locale": {
          "default": null,
          "description": "The app's own language (per-app locale, Android 13+); the rest of the device keeps its language.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dark_mode": {
          "default": null,
          "description": "Dark theme on or off for the whole device (Android 10+).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "font_scale": {
          "default": null,
          "description": "Font size multiplier for the whole device (1 is the default size).",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.5,
              "maximum": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "animations": {
          "default": null,
          "description": "System animations; false turns them off so screens settle at once and runs are steadier.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "onboarding": {
      "description": "Taps that get past the first-run screens, replayed after every launch: while one of these elements is on screen it is tapped (a permission_dialog tap only on Android's permission prompt, any other only on the app). Saved by mobile_open with learn_onboarding.",
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string",
            "enum": [
              "permission_dialog",
              "consent",
              "intro"
            ],
            "description": "The first-run screen this tap gets past."
          },
          "tap": {
            "type": "object",
            "properties": {
              "resource_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$"
              },
              "content_desc": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$"
              }
            },
            "additionalProperties": false,
            "minProperties": 1,
            "description": "The element to tap: every field given must match it exactly, and exactly one element on screen must match."
          }
        },
        "required": [
          "when",
          "tap"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "app",
    "target",
    "permissions",
    "launch"
  ],
  "additionalProperties": false
}

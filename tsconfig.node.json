{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // scripts/ runs on Node's own type stripping, which needs the .ts extension in relative imports
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@/*": ["./src/renderer/*"]
    },
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/main/**/*",
    "src/mcp/**/*",
    "src/cli/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "e2e-renderer/**/*",
    "playwright.renderer.config.ts",
    "electron.vite.config.ts"
  ]
}
